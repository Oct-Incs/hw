<Project>
  <!--
    このファイルを GameDir.user.props にコピーして、
    自分の環境の Horizon Walker インストール先に書き換えてください。
    GameDir.user.props は .gitignore 対象なので各自のパスをコミットせずに済みます。

    BepInEx 6 (IL2CPP版) を導入し、一度ゲームを起動して
    BepInEx\interop フォルダが生成された状態にしてからビルドしてください。
  -->
  <PropertyGroup>
    <GameDir>D:\SteamLibrary\steamapps\common\Horizon Walker</GameDir>
  </PropertyGroup>
</Project>
