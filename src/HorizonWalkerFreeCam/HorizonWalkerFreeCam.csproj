<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HorizonWalkerFreeCam</AssemblyName>
    <RootNamespace>HorizonWalkerFreeCam</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!--
      Horizon Walker は IL2CPP ビルドのため、BepInEx 6 (IL2CPP版) を導入し、
      ゲームを一度起動して自動生成される BepInEx/core, BepInEx/interop の
      アセンブリを直接参照します(ゲームのバージョンごとに生成物が変わるため、
      汎用パッケージとして同梱することができません)。

      既定値は Steam の標準パスです。異なる場合は GameDir.user.props で上書きしてください。
      (GameDir.user.props は .gitignore 対象です)
    -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Horizon Walker</GameDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <BepInExInteropDir>$(GameDir)\BepInEx\interop</BepInExInteropDir>
  </PropertyGroup>

  <!-- ローカルの上書き設定 (存在する場合のみ読み込み) -->
  <Import Project="GameDir.user.props" Condition="Exists('GameDir.user.props')" />

  <ItemGroup>
    <!--
      BepInEx/core, BepInEx/interop 配下の全DLLを参照します。
      interop フォルダはゲームを一度起動しないと生成されません。
      (先に「BepInEx 6 (IL2CPP版)」を導入し、一度ゲームを起動してから本プロジェクトをビルドしてください)
    -->
    <Reference Include="$(BepInExCoreDir)\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
