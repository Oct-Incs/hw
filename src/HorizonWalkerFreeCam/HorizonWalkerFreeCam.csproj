<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HorizonWalkerFreeCam</AssemblyName>
    <RootNamespace>HorizonWalkerFreeCam</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows以外(Linux/Mac)でも net472 をビルドできるように参照アセンブリを追加 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!--
      Unity公式APIのモジュール別リファレンスDLL(NuGet配布)。
      ゲーム本体を持っていなくても、この汎用アセンブリでビルド可能。
      Camera / Transform / Input など基本APIはUnityバージョンが多少違っても互換性がある。
    -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BepInEx本体はNuGet未配布のため、公式リリース(BepInEx_win_x64_5.4.23.5.zip)の
      core/BepInEx.dll, core/0Harmony.dll をそのまま libs/BepInEx に同梱しています。
      (BepInEx: LGPL-2.1 / Harmony: MIT。いずれも再配布可能な公式バイナリです)
    -->
    <Reference Include="BepInEx">
      <HintPath>../../libs/BepInEx/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>../../libs/BepInEx/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
